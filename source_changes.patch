+def visible_results(results, picking, debug=False):
+    if debug or not picking.get("enabled", False):
+        return results
+    return [r for r in results if r.detection.instance_id == picking.get("target_instance_id")]
+
+
+def draw_picking(frame, results, rejected, picking, *, debug=False, roi=None, alpha=.22, fill_masks=True, live=False, max_age_ms=5000):
+    import cv2
+    report = dict(picking)
+    if live and report.get("enabled"):
+        fresh = freshness(frame, max_age_ms)
+        if fresh["status"] != "FRESH":
+            report.update(status="STALE_DISPLAY", target_instance_id=None, pose=None)
+    canvas = draw_results(frame.texture_bgr, visible_results(results, report, debug),
+        rejected_results=rejected, debug_rejected=debug, roi=roi, alpha=alpha, fill_masks=fill_masks)
+    if not report.get("enabled"):
+        return canvas
+    pose = report.get("pose")
+    text = f"PICK {report.get('status')} | target={report.get('target_instance_id')} | CAMERA PROPOSAL"
+    if not pose and report.get("reasons"):
+        text += " | " + report["reasons"][0]
+    cv2.rectangle(canvas, (0, 0), (canvas.shape[1], 48 if pose else 28), (20, 20, 20), -1)
+    cv2.putText(canvas, text, (8, 20), cv2.FONT_HERSHEY_SIMPLEX, .45, (0, 210, 255), 1, cv2.LINE_AA)
+    if pose:
+        p = np.asarray(pose["surface_anchor_xyz_mm"])
+        pixel = tuple(pose["surface_anchor_uv"])
+        cv2.circle(canvas, pixel, 5, (0, 255, 255), -1)
+        label = f"surface XYZ={p[0]:.1f},{p[1]:.1f},{p[2]:.1f} mm | opening={pose['proposed_opening_mm']:.1f} | tilt={pose['tilt_deg']:.1f}"
+        cv2.putText(canvas, label, (8, 40), cv2.FONT_HERSHEY_SIMPLEX, .42, (255, 255, 255), 1, cv2.LINE_AA)
+        projection = fit_projection(frame)
+        if projection:
+            rotation = np.asarray(pose["rotation_camera"])
+            for i, (axis, colour) in enumerate((("x", (0, 0, 255)), ("y jaw", (0, 255, 0)), ("z approach", (255, 150, 0)))):
+                end = p+rotation[:, i]*20
+                if end[2] <= 0:
+                    continue
+                uvw = projection["matrix"] @ end
+                end_pixel = tuple(np.round(uvw[:2]/uvw[2]).astype(int))
+                cv2.arrowedLine(canvas, pixel, end_pixel, colour, 2, cv2.LINE_AA, tipLength=.18)
+                cv2.putText(canvas, axis, end_pixel, cv2.FONT_HERSHEY_SIMPLEX, .4, colour, 1, cv2.LINE_AA)
+    return canvas
